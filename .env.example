# Copy this file to .env and fill in the values. Never commit .env.

# MongoDB connection string (MongoDB Atlas: Database → Connect → Drivers).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name (created automatically).
MONGODB_DB=magiclook

# Password for the dashboard at /admin.html. Use a long one.
ADMIN_PASSWORD=change-me-to-a-long-password
# Random secret (32+ characters) that signs login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the server listens on.
PORT=3000
# Public address of the server, e.g. https://magiclook.onrender.com
# Leave empty when the site and the server share one address (recommended).
PUBLIC_URL=
# Other sites allowed to read the API from the browser, comma-separated.
CORS_ORIGINS=https://magiclooksa.github.io
# Largest upload, in megabytes.
MAX_UPLOAD_MB=100
