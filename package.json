{
  "name": "magic-look-profile",
  "private": true,
  "version": "1.0.0",
  "description": "الملف التعريفي لمؤسسة النظرة الساحرة MAGIC LOOK كموقع ويب",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dashboard": "vite --open /dashboard.html",
    "build": "tsc --noEmit && vite build",
    "build:server": "vite build --config server/vite.config.ts",
    "start": "node server-dist/main.mjs",
    "set-password": "node server-dist/setPassword.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "catalogues": "node tooling/scripts/catalogue-pages.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20.11"
  }
}
