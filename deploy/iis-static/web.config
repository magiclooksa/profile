<?xml version="1.0" encoding="UTF-8"?>
<!--
  Magic Look: static site for IIS. Copy the whole folder's contents into the IIS site's root.

  NEEDS the IIS "URL Rewrite" module (free from Microsoft: https://www.iis.net/downloads/microsoft/url-rewrite).
  Install it BEFORE uploading this file: without it IIS answers every page with error 500.

  - One address for the whole site: https://mgiclook.com/ (no www, https only). http://, www. and
    magiclook.com (with an "a") are sent there with a permanent 301 redirect, keeping the path.
  - Missing pages show 404.html with a real 404 status.
  - The certificate must cover mgiclook.com and www.mgiclook.com (and magiclook.com if it points here).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Any other host name of the site (www., magiclook.com) → https://mgiclook.com, same path. -->
        <rule name="Canonical host" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^(www\.)?(mgiclook|magiclook)\.com$" />
            <add input="{HTTP_HOST}" pattern="^mgiclook\.com$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://mgiclook.com/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- http → https on the main address. -->
        <rule name="HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^mgiclook\.com$" />
          </conditions>
          <action type="Redirect" url="https://mgiclook.com/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- /index.html → / so the home page has one address. -->
        <rule name="Home index" stopProcessing="true">
          <match url="^index\.html$" />
          <conditions><add input="{REQUEST_METHOD}" pattern="^GET$" /></conditions>
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
      </rules>
      <outboundRules>
        <!-- Browsers keep using https once they have seen it. -->
        <rule name="HSTS" enabled="true">
          <match serverVariable="RESPONSE_Strict_Transport_Security" pattern=".*" />
          <conditions><add input="{HTTPS}" pattern="on" ignoreCase="true" /></conditions>
          <action type="Rewrite" value="max-age=31536000" />
        </rule>
      </outboundRules>
    </rewrite>

    <!-- Missing pages: the site's own 404 page, with the 404 status kept. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <!-- remove first so IIS does not fail when a type is already defined on the server -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".webm" />
      <mimeMap fileExtension=".webm" mimeType="video/webm" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".txt" />
      <mimeMap fileExtension=".txt" mimeType="text/plain; charset=utf-8" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml; charset=utf-8" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="text/javascript; charset=utf-8" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- Hashed scripts and styles never change under the same name: cache for a year. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <!-- Photos and films: cache for 7 days. HTML pages and data use the IIS default (always revalidated). -->
  <location path="images">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="videos">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>